+// Copyright (c) 2002-present, OpenMS Inc. -- EKU Tuebingen, ETH Zurich, and FU Berlin
+// SPDX-License-Identifier: BSD-3-Clause
+// $Maintainer: Timo Sachsenberg $
+// $Authors: OpenMS contributors $
+
+#include <sys/stat.h>
+#include <unistd.h>
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+#include <string>
+
+int main(int argc, char** argv)
+{
+  if (argc < 2) { return 2; }
+  // A reused PID can inherit a zero-byte file from a crashed old libomp process.
+  // libomp maps that existing file without checking its size, before main().
+  // Remove only this process's old, empty, regular file owned by this user.
+  const auto launched = std::time(nullptr);
+  const std::string path = "/tmp/__KMP_REGISTERED_LIB_" + std::to_string(getpid());
+  struct stat state {};
+  if (lstat(path.c_str(), &state) == 0 && S_ISREG(state.st_mode) &&
+      state.st_uid == getuid() && state.st_size == 0 && state.st_mtime < launched)
+  {
+    if (unlink(path.c_str()) == 0)
+    {
+      std::fprintf(stderr, "XML_BENCHMARK_REMOVED_STALE_KMP\n");
+    }
+  }
+  // exec preserves the PID and avoids inheriting a Python parent's peak RSS.
+  execv(argv[1], argv + 1);
+  std::fprintf(stderr, "Cannot execute benchmark: %s\n", std::strerror(errno));
+  return 127;
+}
diff --git a/tools/xml-parser-benchmark/run_benchmarks.py b/tools/xml-parser-benchmark/run_benchmarks.py
new file mode 100644
index 0000000000..a70ff7a115
--- /dev/null
+++ b/tools/xml-parser-benchmark/run_benchmarks.py
@@ -0,0 +1,161 @@
+"""Run identical OpenMS workloads in fresh processes and record time/RSS/digests.
+
+Example: python run_benchmarks.py --binary build/xml_parser_benchmark \
+  --backend xerces=/snapshots/xerces/lib --backend libxml2=/snapshots/libxml2/lib \
+  --input data/medium.mzML --input data/large.mzML --output results.json
+"""
+import argparse
+from collections import defaultdict
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import random
+import statistics
+import subprocess
+import sys
+import tempfile
+import time
+
+
+def measured(command, environment, timeout):
+    with tempfile.TemporaryFile() as stdout, tempfile.TemporaryFile() as stderr:
+        begin = time.perf_counter()
+        process = subprocess.Popen(command, stdout=stdout, stderr=stderr, env=environment)
+        deadline = begin + timeout
+        while True:
+            child, status, usage = os.wait4(process.pid, os.WNOHANG)
+            if child:
+                break
+            if time.perf_counter() >= deadline:
+                process.kill()
+                child, status, usage = os.wait4(process.pid, 0)
+                process.returncode = os.waitstatus_to_exitcode(status)
+                raise TimeoutError(f'Benchmark timed out: {command}')
+            time.sleep(0.02)
+        process.returncode = os.waitstatus_to_exitcode(status)
+        stdout.seek(0)
+        stderr.seek(0)
+        output, errors = stdout.read().decode(), stderr.read().decode()
+        process_data = dict(process_seconds=time.perf_counter() - begin,
+                            max_rss_bytes=usage.ru_maxrss * (1 if sys.platform == 'darwin' else 1024),
+                            user_seconds=usage.ru_utime, system_seconds=usage.ru_stime,
+                            removed_stale_kmp='XML_BENCHMARK_REMOVED_STALE_KMP' in errors)
+        if process.returncode:
+            return dict(ok=False, exit_code=process.returncode,
+                        phase='main' if 'XML_BENCHMARK_MAIN_STARTED' in errors else 'startup',
+                        stdout=output[-8192:], stderr=errors[-8192:], **process_data)
+        lines = [line for line in output.splitlines() if line.startswith('{')]
+        result = json.loads(lines[-1])
+        result.update(ok=True, **process_data)
+        return result
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with open(path, 'rb') as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b''):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def summarize(records):
+    groups = defaultdict(list)
+    for record in records:
+        groups[(record['backend'], record['input'], record['mode'], record['workers'])].append(record)
+    result = []
+    for (backend, filename, mode, workers), rows in sorted(groups.items()):
+        seconds = [row['seconds'] for row in rows]
+        rss = [row['max_rss_bytes'] / 1024 ** 2 for row in rows]
+        median = statistics.median(seconds)
+        item = dict(backend=backend, input=filename, mode=mode, workers=workers,
+                    repetitions=len(rows), seconds_median=median, seconds_min=min(seconds),
+                    seconds_max=max(seconds), rss_mib_median=statistics.median(rss),
+                    rss_mib_max=max(rss), hash_per_worker=rows[0]['hash_per_worker'])
+        if all('resident_rss_bytes' in row for row in rows):
+            item['resident_rss_mib_median'] = statistics.median(row['resident_rss_bytes'] / 1024 ** 2 for row in rows)
+        item['job_open_seconds_median'] = statistics.median(job['open_seconds'] for row in rows for job in row['jobs'])
+        item['job_read_seconds_median'] = statistics.median(job['read_seconds'] for row in rows for job in row['jobs'])
+        if mode == 'stream':
+            item['aggregate_mib_per_second'] = rows[0]['file_bytes'] * workers / median / 1024 ** 2
+        elif mode == 'indexed':
+            item['aggregate_spectra_per_second'] = rows[0]['spectra_per_worker'] * workers / median
+        result.append(item)
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--binary', required=True, type=Path)
+    parser.add_argument('--backend', required=True, action='append', help='LABEL=directory of OpenMS libraries')
+    parser.add_argument('--input', required=True, action='append', type=Path)
+    parser.add_argument('--workers', default='1,2,4,8')
+    parser.add_argument('--modes', default='stream,indexed,index-open')
+    parser.add_argument('--repetitions', type=int, default=5)
+    parser.add_argument('--queries', type=int, default=2048)
+    parser.add_argument('--timeout', type=int, default=600)
+    parser.add_argument('--startup-retries', type=int, default=1)
+    parser.add_argument('--output', required=True, type=Path)
+    arguments = parser.parse_args()
+    backends = dict(item.split('=', 1) for item in arguments.backend)
+    workers = [int(item) for item in arguments.workers.split(',')]
+    if arguments.repetitions < 1 or any(value < 1 for value in workers):
+        parser.error('Repetitions and worker counts must be positive')
+    inputs = {str(path.resolve()): dict(bytes=path.stat().st_size, sha256=sha256(path)) for path in arguments.input}
+    library_files = {label: {str(path.resolve()): sha256(path) for path in Path(directory).glob('lib*')
+                            if path.is_file()} for label, directory in backends.items()}
+    launcher = arguments.binary.resolve().with_name('xml_benchmark_launcher')
+    if not launcher.is_file():
+        parser.error('Build xml_benchmark_launcher next to the benchmark binary')
+    report = dict(platform=platform.platform(), machine=platform.machine(), python=sys.version,
+                  cpu_count=os.cpu_count(), binary=str(arguments.binary.resolve()),
+                  binary_sha256=sha256(arguments.binary), backends=backends, libraries=library_files, inputs=inputs,
+                  parameters=vars(arguments) | {'binary': str(arguments.binary),
+                    'input': [str(path) for path in arguments.input], 'output': str(arguments.output)},
+                  launcher_sha256=sha256(launcher), records=[], failures=[], summary=[])
+    matrix = [(backend, filename, mode, worker, repetition)
+              for backend in backends for filename in inputs
+              for mode in arguments.modes.split(',') for worker in workers
+              for repetition in range(arguments.repetitions)
+              if mode in ('stream', 'load', 'idle') or not filename.endswith(('.gz', '.bz2', '.zip'))]
+    random.Random(20261019).shuffle(matrix)
+    digests = {}
+    arguments.output.parent.mkdir(parents=True, exist_ok=True)
+    for number, (backend, filename, mode, worker, repetition) in enumerate(matrix, 1):
+        environment = dict(os.environ, OMP_NUM_THREADS='1', OPENBLAS_NUM_THREADS='1')
+        variable = 'DYLD_LIBRARY_PATH' if sys.platform == 'darwin' else 'LD_LIBRARY_PATH'
+        environment[variable] = str(Path(backends[backend]).resolve()) + os.pathsep + environment.get(variable, '')
+        command = [str(launcher), str(arguments.binary.resolve()), mode, filename, str(worker), str(arguments.queries)]
+        for attempt in range(arguments.startup_retries + 1):
+            row = measured(command, environment, arguments.timeout)
+            if row['ok']:
+                break
+            row.update(backend=backend, input=filename, mode=mode, workers=worker,
+                       repetition=repetition, attempt=attempt)
+            report['failures'].append(row)
+            arguments.output.write_text(json.dumps(report, indent=2) + '\n')
+            print(f'FAILED {backend} {Path(filename).name} {mode} x{worker}: '
+                  f'{row["phase"]}, exit {row["exit_code"]}', flush=True)
+            if row['phase'] != 'startup':
+                break
+        if not row['ok']:
+            continue
+        if not row.get('openms_library') or Path(row['openms_library']).resolve().parent != Path(backends[backend]).resolve():
+            raise RuntimeError(f'Wrong OpenMS library loaded for {backend}: {row.get("openms_library")}')
+        row.update(backend=backend, input=filename, repetition=repetition)
+        key = filename, mode
+        fingerprint = (row['hash_per_worker'], row['spectra_per_worker'], row['chromatograms_per_worker'],
+                       row['points_per_worker'], row['index_spectra'], row['index_chromatograms'])
+        if key in digests and digests[key] != fingerprint:
+            raise RuntimeError(f'Decoded-output mismatch for {key}: {digests[key]} != {fingerprint}, backend={backend}')
+        digests[key] = fingerprint
+        report['records'].append(row)
+        report['summary'] = summarize(report['records'])
+        arguments.output.write_text(json.dumps(report, indent=2) + '\n')
+        print(f'{number}/{len(matrix)} {backend} {Path(filename).name} {mode} x{worker}: '
+              f'{row["seconds"]:.3f}s, {row["max_rss_bytes"] / 1024 ** 2:.1f} MiB', flush=True)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/xml-parser-benchmark/run_openmp_scaling.py b/tools/xml-parser-benchmark/run_openmp_scaling.py
new file mode 100644
index 0000000000..8ab5ea29c3
--- /dev/null
+++ b/tools/xml-parser-benchmark/run_openmp_scaling.py
@@ -0,0 +1,77 @@
+"""Fixed-work streaming: one reader, varying OpenMP binary-decoding threads.
+
+Use a completed run_benchmarks.py report to select the identical binary,
+backend snapshots, inputs and expected decoded results. Run without other jobs.
+"""
+import argparse
+from collections import defaultdict
+import json
+import os
+from pathlib import Path
+import random
+import statistics
+import sys
+
+from run_benchmarks import measured, sha256
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--matrix', required=True, type=Path)
+    parser.add_argument('--output', required=True, type=Path)
+    parser.add_argument('--threads', default='1,2,4,8')
+    args = parser.parse_args()
+    matrix = json.loads(args.matrix.read_text())
+    thread_counts = [int(t) for t in args.threads.split(',')]
+    assert all(t > 0 for t in thread_counts)
+    binary = Path(matrix['binary'])
+    launcher = binary.with_name('xml_benchmark_launcher')
+    assert sha256(binary) == matrix['binary_sha256']
+    assert sha256(launcher) == matrix['launcher_sha256']
+    inputs = {p: data for p, data in matrix['inputs'].items()
+              if Path(p).name in ('large.mzML', 'medium-zlib.mzML')}
+    assert len(inputs) == 2
+    assert all(sha256(p) == data['sha256'] for p, data in inputs.items())
+    expected = {p: next(r['hash_per_worker'] for r in matrix['records']
+                       if r['input'] == p and r['mode'] == 'stream') for p in inputs}
+    report = {k:matrix[k] for k in ('platform','machine','binary','binary_sha256','launcher_sha256','backends','libraries')}
+    report.update(kind='fixed-work OpenMP streaming', inputs=inputs, reader_workers=1,
+                  openmp_threads=thread_counts, repetitions=5, records=[], failures=[], summary=[])
+    jobs = [(b,p,t,r) for b in matrix['backends'] for p in inputs
+            for t in thread_counts for r in range(5)]
+    random.Random(20261020).shuffle(jobs)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    for n,(backend,filename,threads,repetition) in enumerate(jobs,1):
+        env = dict(os.environ, OMP_NUM_THREADS=str(threads), OMP_DYNAMIC='FALSE', OPENBLAS_NUM_THREADS='1')
+        variable = 'DYLD_LIBRARY_PATH' if sys.platform == 'darwin' else 'LD_LIBRARY_PATH'
+        directory = Path(matrix['backends'][backend]).resolve()
+        env[variable] = str(directory) + os.pathsep + env.get(variable,'')
+        command = [str(launcher),str(binary),'stream',filename,'1','0']
+        for attempt in range(2):
+            row = measured(command,env,600)
+            if row['ok']:
+                break
+            report['failures'].append(dict(row,backend=backend,input=filename,openmp_threads=threads,repetition=repetition,attempt=attempt))
+            args.output.write_text(json.dumps(report,indent=2)+'\n')
+            if row['phase'] != 'startup':
+                raise RuntimeError(report['failures'][-1])
+        if not row['ok']:
+            raise RuntimeError(report['failures'][-1])
+        assert Path(row['openms_library']).resolve().parent == directory
+        assert row['hash_per_worker'] == expected[filename]
+        row.update(backend=backend,input=filename,openmp_threads=threads,repetition=repetition)
+        report['records'].append(row)
+        groups=defaultdict(list)
+        for item in report['records']:
+            groups[item['backend'],item['input'],item['openmp_threads']].append(item)
+        report['summary']=[dict(backend=b,input=p,openmp_threads=t,repetitions=len(rows),
+            seconds_median=statistics.median(x['seconds'] for x in rows),
+            seconds_min=min(x['seconds'] for x in rows),seconds_max=max(x['seconds'] for x in rows),
+            rss_mib_median=statistics.median(x['max_rss_bytes']/1024**2 for x in rows))
+            for (b,p,t),rows in sorted(groups.items())]
+        args.output.write_text(json.dumps(report,indent=2)+'\n')
+        print(f'{n}/{len(jobs)} {backend} {Path(filename).name} OpenMP={threads}: {row["seconds"]:.3f}s',flush=True)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/xml-parser-benchmark/test_benchmark.py b/tools/xml-parser-benchmark/test_benchmark.py
new file mode 100644
index 0000000000..f8a4e192a3
--- /dev/null
+++ b/tools/xml-parser-benchmark/test_benchmark.py
@@ -0,0 +1,72 @@
+"""Exercise decoded equivalence, worker independence and benchmark failures."""
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+BINARY = sys.argv.pop(1)
+LAUNCHER = str(Path(BINARY).with_name('xml_benchmark_launcher'))
+
+
+def invoke(*args):
+    result = subprocess.run([LAUNCHER, BINARY, *map(str, args)], check=True, capture_output=True, text=True)
+    lines = [line for line in result.stdout.splitlines() if line.startswith('{')]
+    return json.loads(lines[-1]) if lines else None
+
+
+class BenchmarkTest(unittest.TestCase):
+    def test_equivalence_and_workers(self):
+        with tempfile.TemporaryDirectory() as directory:
+            for compression in ('plain', 'zlib'):
+                path = Path(directory) / f'{compression}.mzML'
+                invoke('generate', path, 17, 31, compression)
+                result = invoke('verify', path)
+                self.assertTrue(result['verified'])
+                self.assertEqual(result['spectra'], 17)
+                self.assertEqual(result['points'], 17 * 31 + 17)
+                for mode in ('stream', 'load', 'indexed', 'index-open', 'contexts', 'idle'):
+                    single = invoke(mode, path, 1, 41)
+                    parallel = invoke(mode, path, 4, 41)
+                    self.assertEqual(single['hash_per_worker'], parallel['hash_per_worker'])
+                    self.assertEqual(single['points_per_worker'], parallel['points_per_worker'])
+                    if mode in ('stream', 'load'):
+                        self.assertEqual(single['hash_per_worker'], result['hash'])
+                    if mode == 'contexts':
+                        self.assertEqual(single['index_spectra'], 17)
+                        self.assertGreater(single['resident_rss_bytes'], 0)
+                        self.assertGreater(parallel['resident_rss_bytes'], 0)
+
+    def test_errors_propagate(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'broken.mzML'
+            path.write_text('<mzML><broken></mzML>')
+            for mode in ('stream', 'load', 'indexed', 'contexts'):
+                result = subprocess.run([LAUNCHER, BINARY, mode, str(path), '2', '3'], capture_output=True)
+                self.assertNotEqual(result.returncode, 0)
+
+    def test_stale_registration_cleanup(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'registration.mzML'
+            invoke('generate', path, 1, 3, 'plain')
+            code = '''import os, sys
+p = '/tmp/__KMP_REGISTERED_LIB_' + str(os.getpid())
+try:
+    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+except FileExistsError:
+    sys.exit(77)
+os.close(fd)
+os.utime(p, (0, 0))
+os.execv(sys.argv[1], sys.argv[1:])
+'''
+            result = subprocess.run([sys.executable, '-c', code, LAUNCHER, BINARY,
+                                     'stream', str(path), '1', '1'], capture_output=True, text=True)
+            if result.returncode == 77:
+                self.skipTest('Own PID already has an existing runtime registration file')
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertIn('XML_BENCHMARK_REMOVED_STALE_KMP', result.stderr)
+
+
+if __name__ == '__main__':
+    unittest.main()
