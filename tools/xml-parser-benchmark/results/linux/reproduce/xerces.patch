diff --git a/tools/xml-parser-benchmark/benchmark.cpp b/tools/xml-parser-benchmark/benchmark.cpp
new file mode 100644
index 0000000000..4ffa7a25d6
--- /dev/null
+++ b/tools/xml-parser-benchmark/benchmark.cpp
@@ -0,0 +1,320 @@
+// Copyright (c) 2002-present, OpenMS Inc. -- EKU Tuebingen, ETH Zurich, and FU Berlin
+// SPDX-License-Identifier: BSD-3-Clause
+// $Maintainer: Timo Sachsenberg $
+// $Authors: OpenMS contributors $
+
+#include <OpenMS/FORMAT/DATAACCESS/MSDataWritingConsumer.h>
+#include <OpenMS/FORMAT/MzMLFile.h>
+#include <OpenMS/INTERFACES/IMSDataConsumer.h>
+#include <OpenMS/KERNEL/MSExperiment.h>
+#include <OpenMS/KERNEL/OnDiscMSExperiment.h>
+
+#include <barrier>
+#include <bit>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <exception>
+#include <filesystem>
+#include <iomanip>
+#include <iostream>
+#include <random>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+#if defined(__APPLE__)
+#include <mach-o/dyld.h>
+#elif defined(__linux__)
+#include <link.h>
+#endif
+
+namespace
+{
+  using Clock = std::chrono::steady_clock;
+
+  std::string loadedLibrary()
+  {
+    std::string result;
+#if defined(__APPLE__)
+    for (std::uint32_t i = 0; i < _dyld_image_count(); ++i)
+    {
+      const std::string path(_dyld_get_image_name(i));
+      if (std::filesystem::path(path).filename() == "libOpenMS.dylib") { result = path; }
+    }
+#elif defined(__linux__)
+    dl_iterate_phdr([](dl_phdr_info* info, std::size_t, void* data)
+    {
+      const std::string path(info->dlpi_name);
+      if (std::filesystem::path(path).filename().string().starts_with("libOpenMS.so"))
+      {
+        *static_cast<std::string*>(data) = path;
+      }
+      return 0;
+    }, &result);
+#endif
+    return result;
+  }
+
+  // Hash every decoded coordinate/intensity, independently of XML text formatting.
+  struct Digest final : OpenMS::Interfaces::IMSDataConsumer
+  {
+    std::uint64_t hash = 14695981039346656037ULL;
+    std::uint64_t spectra = 0, chromatograms = 0, points = 0;
+
+    void word(std::uint64_t value)
+    {
+      for (unsigned i = 0; i < 8; ++i)
+      {
+        hash = (hash ^ ((value >> (8 * i)) & 255)) * 1099511628211ULL;
+      }
+    }
+
+    void text(const std::string& value)
+    {
+      word(value.size());
+      for (const unsigned char character : value) { hash = (hash ^ character) * 1099511628211ULL; }
+    }
+
+    void consumeSpectrum(OpenMS::MSSpectrum& spectrum) override
+    {
+      ++spectra;
+      points += spectrum.size();
+      word(1);
+      word(spectrum.size());
+      text(spectrum.getNativeID());
+      for (const auto& peak : spectrum)
+      {
+        word(std::bit_cast<std::uint64_t>(peak.getMZ()));
+        word(std::bit_cast<std::uint64_t>(static_cast<double>(peak.getIntensity())));
+      }
+    }
+
+    void consumeChromatogram(OpenMS::MSChromatogram& chromatogram) override
+    {
+      ++chromatograms;
+      points += chromatogram.size();
+      word(2);
+      word(chromatogram.size());
+      text(chromatogram.getNativeID());
+      for (const auto& peak : chromatogram)
+      {
+        word(std::bit_cast<std::uint64_t>(peak.getRT()));
+        word(std::bit_cast<std::uint64_t>(static_cast<double>(peak.getIntensity())));
+      }
+    }
+
+    void setExpectedSize(std::size_t, std::size_t) override {}
+    void setExperimentalSettings(const OpenMS::ExperimentalSettings&) override {}
+    bool operator==(const Digest& other) const
+    {
+      return hash == other.hash && spectra == other.spectra &&
+        chromatograms == other.chromatograms && points == other.points;
+    }
+  };
+
+  struct Result
+  {
+    Digest digest;
+    double open_seconds = 0;
+    double read_seconds = 0;
+    std::size_t index_spectra = 0, index_chromatograms = 0;
+  };
+
+  Result run(const std::string& mode, const std::string& path, std::size_t queries)
+  {
+    Result result;
+    const auto begin = Clock::now();
+    if (mode == "stream")
+    {
+      OpenMS::MzMLFile().transform(path, &result.digest, true, true);
+    }
+    else if (mode == "indexed" || mode == "index-open")
+    {
+      OpenMS::OnDiscMSExperiment experiment;
+      if (!experiment.openFile(path, true))
+      {
+        throw std::runtime_error("Input has no usable mzML index");
+      }
+      const auto opened = Clock::now();
+      result.open_seconds = std::chrono::duration<double>(opened - begin).count();
+      result.index_spectra = experiment.getNrSpectra();
+      result.index_chromatograms = experiment.getNrChromatograms();
+      if (mode == "indexed")
+      {
+        if (experiment.getNrSpectra() == 0)
+        {
+          throw std::runtime_error("Indexed input has no spectra");
+        }
+        std::mt19937_64 random(20261019);
+        for (std::size_t i = 0; i < queries; ++i)
+        {
+          auto spectrum = experiment.getSpectrum(random() % experiment.getNrSpectra());
+          result.digest.consumeSpectrum(spectrum);
+        }
+      }
+      result.read_seconds = std::chrono::duration<double>(Clock::now() - opened).count();
+    }
+    else
+    {
+      throw std::runtime_error("Expected stream, indexed, or index-open");
+    }
+    if (mode == "stream")
+    {
+      result.read_seconds = std::chrono::duration<double>(Clock::now() - begin).count();
+    }
+    return result;
+  }
+
+  void generate(const std::string& path, std::size_t count, std::size_t points, bool compressed)
+  {
+    OpenMS::PlainMSDataWritingConsumer writer(path);
+    OpenMS::PeakFileOptions options;
+    options.setCompression(compressed);
+    options.setWriteIndex(true);
+    writer.setOptions(options);
+    writer.setExpectedSize(count, 1);
+    writer.setExperimentalSettings(OpenMS::ExperimentalSettings());
+    std::mt19937 random(20261019);
+    for (std::size_t i = 0; i < count; ++i)
+    {
+      OpenMS::MSSpectrum spectrum;
+      spectrum.setNativeID("scan=" + std::to_string(i + 1));
+      spectrum.setRT(static_cast<double>(i) * 0.5);
+      spectrum.setMSLevel(1);
+      spectrum.setType(OpenMS::SpectrumSettings::SpectrumType::CENTROID);
+      spectrum.setMetaValue("xml_poc_note", std::string("Unicode \xCE\xB2 & <escaped> \"value\""));
+      spectrum.reserve(points);
+      for (std::size_t p = 0; p < points; ++p)
+      {
+        OpenMS::Peak1D peak;
+        peak.setMZ(100.0 + static_cast<double>(p) * 0.01 + static_cast<double>(i % 17) * 0.00001);
+        peak.setIntensity(static_cast<float>(random() % 1000000) / 8.0F);
+        spectrum.push_back(peak);
+      }
+      writer.consumeSpectrum(spectrum);
+    }
+    OpenMS::MSChromatogram chromatogram;
+    chromatogram.setNativeID("TIC");
+    for (std::size_t i = 0; i < count; ++i)
+    {
+      OpenMS::ChromatogramPeak peak;
+      peak.setRT(static_cast<double>(i) * 0.5);
+      peak.setIntensity(static_cast<float>(i % 101));
+      chromatogram.push_back(peak);
+    }
+    writer.consumeChromatogram(chromatogram);
+  }
+
+  void verify(const std::string& path)
+  {
+    OpenMS::MSExperiment loaded;
+    OpenMS::MzMLFile().load(path, loaded);
+    Digest expected;
+    for (auto& spectrum : loaded) { expected.consumeSpectrum(spectrum); }
+    for (auto& chromatogram : loaded.getChromatograms()) { expected.consumeChromatogram(chromatogram); }
+    const auto streamed = run("stream", path, 0).digest;
+    OpenMS::OnDiscMSExperiment indexed;
+    if (!indexed.openFile(path)) { throw std::runtime_error("Index verification failed"); }
+    Digest actual;
+    for (std::size_t i = 0; i < indexed.getNrSpectra(); ++i)
+    {
+      auto spectrum = indexed.getSpectrum(i);
+      const auto& original = loaded.getSpectra().at(i);
+      if (spectrum.getRT() != original.getRT() || spectrum.getMSLevel() != original.getMSLevel() ||
+          spectrum.getFloatDataArrays() != original.getFloatDataArrays() ||
+          spectrum.getIntegerDataArrays() != original.getIntegerDataArrays() ||
+          spectrum.getStringDataArrays() != original.getStringDataArrays() ||
+          spectrum.getMetaValue("xml_poc_note") != original.getMetaValue("xml_poc_note"))
+      {
+        throw std::runtime_error("Indexed spectrum metadata differ from full load");
+      }
+      actual.consumeSpectrum(spectrum);
+    }
+    for (std::size_t i = 0; i < indexed.getNrChromatograms(); ++i)
+    {
+      auto chromatogram = indexed.getChromatogram(i);
+      actual.consumeChromatogram(chromatogram);
+    }
+    if (!(expected == streamed) || !(expected == actual))
+    {
+      throw std::runtime_error("Decoded data differ between load, streaming and indexed access");
+    }
+    std::cout << "{\"verified\":true,\"spectra\":" << expected.spectra
+              << ",\"points\":" << expected.points << ",\"hash\":\"" << expected.hash << "\"}\n";
+  }
+}
+
+int main(int argc, char** argv)
+{
+  try
+  {
+    if (argc < 3) { throw std::runtime_error("Usage: xml_parser_benchmark MODE FILE [WORKERS|SPECTRA] [QUERIES|POINTS] [ZLIB]"); }
+    const std::string mode(argv[1]), path(argv[2]);
+    const std::size_t workers = argc > 3 ? std::stoull(argv[3]) : 1;
+    const std::size_t queries = argc > 4 ? std::stoull(argv[4]) : 1000;
+    if (workers == 0) { throw std::runtime_error("Worker/spectrum count must be positive"); }
+    if (mode == "generate")
+    {
+      generate(path, workers, queries, argc > 5 && std::string(argv[5]) == "zlib");
+      return 0;
+    }
+    if (mode == "verify") { verify(path); return 0; }
+
+    // Warm shared CV/parser initialization before independent worker jobs.
+    OpenMS::MzMLFile warmup;
+    OpenMS::MSExperiment empty;
+    std::string warmup_xml;
+    warmup.storeBuffer(warmup_xml, empty);
+    warmup.loadBuffer(warmup_xml, empty);
+    std::vector<Result> results(workers);
+    std::vector<std::exception_ptr> errors(workers);
+    std::barrier start(static_cast<std::ptrdiff_t>(workers + 1));
+    std::vector<std::jthread> threads;
+    for (std::size_t i = 0; i < workers; ++i)
+    {
+      threads.emplace_back([&, i]
+      {
+        start.arrive_and_wait();
+        try { results[i] = run(mode, path, queries); }
+        catch (...) { errors[i] = std::current_exception(); }
+      });
+    }
+    const auto begin = Clock::now();
+    start.arrive_and_wait();
+    threads.clear();
+    const double seconds = std::chrono::duration<double>(Clock::now() - begin).count();
+    for (const auto& error : errors) { if (error) { std::rethrow_exception(error); } }
+    for (const auto& result : results)
+    {
+      if (!(result.digest == results.front().digest)) { throw std::runtime_error("Worker digest mismatch"); }
+      if (result.index_spectra != results.front().index_spectra ||
+          result.index_chromatograms != results.front().index_chromatograms)
+      {
+        throw std::runtime_error("Worker index count mismatch");
+      }
+    }
+    std::cout << std::setprecision(12) << "{\"mode\":\"" << mode << "\",\"workers\":" << workers
+              << ",\"openms_library\":" << std::quoted(loadedLibrary())
+              << ",\"seconds\":" << seconds << ",\"file_bytes\":" << std::filesystem::file_size(path)
+              << ",\"spectra_per_worker\":" << results.front().digest.spectra
+              << ",\"chromatograms_per_worker\":" << results.front().digest.chromatograms
+              << ",\"points_per_worker\":" << results.front().digest.points
+              << ",\"index_spectra\":" << results.front().index_spectra
+              << ",\"index_chromatograms\":" << results.front().index_chromatograms
+              << ",\"hash_per_worker\":\"" << results.front().digest.hash << "\",\"jobs\":[";
+    for (std::size_t i = 0; i < workers; ++i)
+    {
+      if (i) { std::cout << ','; }
+      std::cout << "{\"open_seconds\":" << results[i].open_seconds
+                << ",\"read_seconds\":" << results[i].read_seconds << '}';
+    }
+    std::cout << "]}\n";
+  }
+  catch (const std::exception& error)
+  {
+    std::cerr << error.what() << '\n';
+    return 1;
+  }
+  return 0;
+}
diff --git a/tools/xml-parser-benchmark/run_benchmarks.py b/tools/xml-parser-benchmark/run_benchmarks.py
new file mode 100644
index 0000000000..eea165d407
--- /dev/null
+++ b/tools/xml-parser-benchmark/run_benchmarks.py
@@ -0,0 +1,138 @@
+"""Run identical OpenMS workloads in fresh processes and record time/RSS/digests.
+
+Example: python run_benchmarks.py --binary build/xml_parser_benchmark \
+  --backend xerces=/snapshots/xerces/lib --backend libxml2=/snapshots/libxml2/lib \
+  --input data/medium.mzML --input data/large.mzML --output results.json
+"""
+import argparse
+from collections import defaultdict
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import random
+import statistics
+import subprocess
+import sys
+import tempfile
+import time
+
+
+def measured(command, environment, timeout):
+    with tempfile.TemporaryFile() as stdout, tempfile.TemporaryFile() as stderr:
+        begin = time.perf_counter()
+        process = subprocess.Popen(command, stdout=stdout, stderr=stderr, env=environment)
+        deadline = begin + timeout
+        while True:
+            child, status, usage = os.wait4(process.pid, os.WNOHANG)
+            if child:
+                break
+            if time.perf_counter() >= deadline:
+                process.kill()
+                child, status, usage = os.wait4(process.pid, 0)
+                process.returncode = os.waitstatus_to_exitcode(status)
+                raise TimeoutError(f'Benchmark timed out: {command}')
+            time.sleep(0.02)
+        process.returncode = os.waitstatus_to_exitcode(status)
+        stdout.seek(0)
+        stderr.seek(0)
+        output, errors = stdout.read().decode(), stderr.read().decode()
+        if process.returncode:
+            raise RuntimeError(f'{command} exited {process.returncode}\n{output}\n{errors}')
+        lines = [line for line in output.splitlines() if line.startswith('{')]
+        result = json.loads(lines[-1])
+        result.update(process_seconds=time.perf_counter() - begin,
+                      max_rss_bytes=usage.ru_maxrss * (1 if sys.platform == 'darwin' else 1024),
+                      user_seconds=usage.ru_utime, system_seconds=usage.ru_stime)
+        return result
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with open(path, 'rb') as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b''):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def summarize(records):
+    groups = defaultdict(list)
+    for record in records:
+        groups[(record['backend'], record['input'], record['mode'], record['workers'])].append(record)
+    result = []
+    for (backend, filename, mode, workers), rows in sorted(groups.items()):
+        seconds = [row['seconds'] for row in rows]
+        rss = [row['max_rss_bytes'] / 1024 ** 2 for row in rows]
+        median = statistics.median(seconds)
+        item = dict(backend=backend, input=filename, mode=mode, workers=workers,
+                    repetitions=len(rows), seconds_median=median, seconds_min=min(seconds),
+                    seconds_max=max(seconds), rss_mib_median=statistics.median(rss),
+                    rss_mib_max=max(rss), hash_per_worker=rows[0]['hash_per_worker'])
+        item['job_open_seconds_median'] = statistics.median(job['open_seconds'] for row in rows for job in row['jobs'])
+        item['job_read_seconds_median'] = statistics.median(job['read_seconds'] for row in rows for job in row['jobs'])
+        if mode == 'stream':
+            item['aggregate_mib_per_second'] = rows[0]['file_bytes'] * workers / median / 1024 ** 2
+        elif mode == 'indexed':
+            item['aggregate_spectra_per_second'] = rows[0]['spectra_per_worker'] * workers / median
+        result.append(item)
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--binary', required=True, type=Path)
+    parser.add_argument('--backend', required=True, action='append', help='LABEL=directory of OpenMS libraries')
+    parser.add_argument('--input', required=True, action='append', type=Path)
+    parser.add_argument('--workers', default='1,2,4,8')
+    parser.add_argument('--modes', default='stream,indexed,index-open')
+    parser.add_argument('--repetitions', type=int, default=5)
+    parser.add_argument('--queries', type=int, default=2048)
+    parser.add_argument('--timeout', type=int, default=600)
+    parser.add_argument('--output', required=True, type=Path)
+    arguments = parser.parse_args()
+    backends = dict(item.split('=', 1) for item in arguments.backend)
+    workers = [int(item) for item in arguments.workers.split(',')]
+    if arguments.repetitions < 1 or any(value < 1 for value in workers):
+        parser.error('Repetitions and worker counts must be positive')
+    inputs = {str(path.resolve()): dict(bytes=path.stat().st_size, sha256=sha256(path)) for path in arguments.input}
+    library_files = {label: {str(path.resolve()): sha256(path) for path in Path(directory).glob('*OpenMS*')
+                            if path.is_file()} for label, directory in backends.items()}
+    report = dict(platform=platform.platform(), machine=platform.machine(), python=sys.version,
+                  cpu_count=os.cpu_count(), binary=str(arguments.binary.resolve()),
+                  binary_sha256=sha256(arguments.binary), backends=backends, libraries=library_files, inputs=inputs,
+                  parameters=vars(arguments) | {'binary': str(arguments.binary),
+                    'input': [str(path) for path in arguments.input], 'output': str(arguments.output)},
+                  records=[], summary=[])
+    matrix = [(backend, filename, mode, worker, repetition)
+              for backend in backends for filename in inputs
+              for mode in arguments.modes.split(',') for worker in workers
+              for repetition in range(arguments.repetitions)
+              if mode == 'stream' or not filename.endswith(('.gz', '.bz2', '.zip'))]
+    random.Random(20261019).shuffle(matrix)
+    digests = {}
+    arguments.output.parent.mkdir(parents=True, exist_ok=True)
+    for number, (backend, filename, mode, worker, repetition) in enumerate(matrix, 1):
+        environment = dict(os.environ, OMP_NUM_THREADS='1', OPENBLAS_NUM_THREADS='1')
+        variable = 'DYLD_LIBRARY_PATH' if sys.platform == 'darwin' else 'LD_LIBRARY_PATH'
+        environment[variable] = str(Path(backends[backend]).resolve()) + os.pathsep + environment.get(variable, '')
+        command = [str(arguments.binary.resolve()), mode, filename, str(worker), str(arguments.queries)]
+        row = measured(command, environment, arguments.timeout)
+        if not row.get('openms_library') or Path(row['openms_library']).resolve().parent != Path(backends[backend]).resolve():
+            raise RuntimeError(f'Wrong OpenMS library loaded for {backend}: {row.get("openms_library")}')
+        row.update(backend=backend, input=filename, repetition=repetition)
+        key = filename, mode
+        fingerprint = (row['hash_per_worker'], row['spectra_per_worker'], row['chromatograms_per_worker'],
+                       row['points_per_worker'], row['index_spectra'], row['index_chromatograms'])
+        if key in digests and digests[key] != fingerprint:
+            raise RuntimeError(f'Decoded-output mismatch for {key}: {digests[key]} != {fingerprint}, backend={backend}')
+        digests[key] = fingerprint
+        report['records'].append(row)
+        report['summary'] = summarize(report['records'])
+        arguments.output.write_text(json.dumps(report, indent=2) + '\n')
+        print(f'{number}/{len(matrix)} {backend} {Path(filename).name} {mode} x{worker}: '
+              f'{row["seconds"]:.3f}s, {row["max_rss_bytes"] / 1024 ** 2:.1f} MiB', flush=True)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/xml-parser-benchmark/test_benchmark.py b/tools/xml-parser-benchmark/test_benchmark.py
new file mode 100644
index 0000000000..6e99a3275f
--- /dev/null
+++ b/tools/xml-parser-benchmark/test_benchmark.py
@@ -0,0 +1,44 @@
+"""Exercise decoded equivalence, worker independence and benchmark failures."""
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+BINARY = sys.argv.pop(1)
+
+
+def invoke(*args):
+    result = subprocess.run([BINARY, *map(str, args)], check=True, capture_output=True, text=True)
+    lines = [line for line in result.stdout.splitlines() if line.startswith('{')]
+    return json.loads(lines[-1]) if lines else None
+
+
+class BenchmarkTest(unittest.TestCase):
+    def test_equivalence_and_workers(self):
+        with tempfile.TemporaryDirectory() as directory:
+            for compression in ('plain', 'zlib'):
+                path = Path(directory) / f'{compression}.mzML'
+                invoke('generate', path, 17, 31, compression)
+                result = invoke('verify', path)
+                self.assertTrue(result['verified'])
+                self.assertEqual(result['spectra'], 17)
+                self.assertEqual(result['points'], 17 * 31 + 17)
+                for mode in ('stream', 'indexed', 'index-open'):
+                    single = invoke(mode, path, 1, 41)
+                    parallel = invoke(mode, path, 4, 41)
+                    self.assertEqual(single['hash_per_worker'], parallel['hash_per_worker'])
+                    self.assertEqual(single['points_per_worker'], parallel['points_per_worker'])
+
+    def test_errors_propagate(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'broken.mzML'
+            path.write_text('<mzML><broken></mzML>')
+            for mode in ('stream', 'indexed'):
+                result = subprocess.run([BINARY, mode, str(path), '2', '3'], capture_output=True)
+                self.assertNotEqual(result.returncode, 0)
+
+
+if __name__ == '__main__':
+    unittest.main()
